{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "seed:mock": "ts-node src/scripts/seedMockMaterials.ts",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "dev:cron": "nodemon src/cron.ts",
    "dev:consumer": "nodemon src/consumer.ts",
    "build": "tsc",
    "postbuild": "mkdir -p dist/database/practice && (ls src/database/practice/*.json >/dev/null 2>&1 && cp src/database/practice/*.json dist/database/practice/ || true)",
    "migration:generate": "sequelize-cli migration:generate --name",
    "migration:run": "sequelize-cli db:migrate",
    "migration:undo": "sequelize-cli db:migrate:undo",
    "migration:undo:all": "sequelize-cli db:migrate:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "firebase-admin": "^13.6.1",
    "helmet": "^7.1.0",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "ollama": "^0.6.3",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.35",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}